111:         def _get_avgpool_scale(kh: int, kw: int) -> Any:
112:             if kh > 255 or kw > 255:
113:                 return 1.0
114:             elif kh == 3 and kw == 3:
115:                 return 9.0 * 7.0 / 64.0
116:             elif kh == 5 and kw == 5:
117:                 return 25.0 * 10.0 / 256.0
118:             elif kh == 6 and kw == 6:
119:                 return 36.0 * 7.0 / 256.0
120:             elif kh == 7 and kw == 7:
121:                 return 49.0 * 21.0 / 1024.0
122:             elif kh == 14 and kw == 14:
123:                 return 196.0 * 21.0 / 4096.0
