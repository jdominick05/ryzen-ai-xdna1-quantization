70:     def convert_leaky_relu_to_dpu_version(self) -> None:
71:         """Convert LeakyReLU to DPU version.
72:         LeakyReLU(alpha) --> LeakyReLU(round(alpha*256)/256)
73:         """
74:         for node in self.model.graph.node:
75:             if node.op_type == "LeakyRelu" and self.should_quantize_node(node):
76:                 alpha_attr = next((attr for attr in node.attribute if attr.name == "alpha"), None)
77:                 if alpha_attr:
78:                     ori_alpha = alpha_attr.f
79:                     dpu_alpha = dpu_leaky_relu_alpha(alpha_attr.f)
80:                     alpha_attr.f = dpu_alpha
81:                     logger.info(
82:                         f"Found Leaky ReLU node {node.name} with alpha={ori_alpha}. "
83:                         f"Replacing with new alpha={dpu_alpha}."
84:                     )
