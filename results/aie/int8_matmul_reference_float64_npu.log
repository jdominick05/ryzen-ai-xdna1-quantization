# The CPU sweep script with its new float64 oracle: 512^3 (int64 ref used to run here) and
# 2048^3 (> 2^30 MACs, the int64 ref used to be skipped here) -- both must print f64-ref OK.
set -u
cd "$HOME/PycharmProjects/ryzen-ai-xdna1-quantization" || exit 1
