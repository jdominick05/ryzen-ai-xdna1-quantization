712: def get_annotate_tensors(model: onnx.ModelProto) -> list[str]:
713:     """
714:     Find patterns in the model where qdq needs to be removed, and then return the corresponding tensor names
715:     annotate_tensors refers to the tensors associated with the input of the qdq that need to be removed
716:     :param model: model object
717:     :return: the annotate tensors
718:     """
719:     matching_output_tensor = []
720:     pad_output_tensor = []
721:     tensor_to_consumer = get_tensor_to_consumer(model)
722:     for node in model.graph.node:
723:         if node.op_type in annotate_op_type and node.output[0] in tensor_to_consumer:
724:             if len(tensor_to_consumer[node.output[0]]) == 1:
725:                 matching_output_tensor.append(node.output[0])
726:         elif node.op_type == "Pad" and node.output[0] in tensor_to_consumer:
727:             if len(tensor_to_consumer[node.output[0]]) == 1:
728:                 pad_output_tensor.append(node.output[0])
729: 
730:     annotate_tensors = []
731:     for node in model.graph.node:
732:         if (is_node_needs_annotated(model, node) and node.input[0] in matching_output_tensor) or (
733:             node.op_type in avg_pool_op_type and node.input[0] in pad_output_tensor
734:         ):
735:             annotate_tensors.append(node.input[0])
736:     return annotate_tensors
814: def scale2pos(scale: float) -> int:
815:     """
816:     Obtain the fixed-point position corresponding to the scale.
817:     To avoid generating infinity during computations,
818:     the range of scale is limited.
819:     :param scale: the scale
820:     :return: the fixed-point position
821:     """
822:     scale = min(max(scale, float(2**-127)), float(2**127))
823:     return int(np.rint(-np.log2(scale)))
