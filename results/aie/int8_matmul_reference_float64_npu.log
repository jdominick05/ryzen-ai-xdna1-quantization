--- run_ref_npu.sh ---
#!/usr/bin/env bash
# NPU proof for the float64 reference patch: the same rows the int8 sweep ran on 2026-09-07
# (results/aie/int8_matmul_sweep_npu.log, seed 1726250518 -> identical A, B), so a PASS!
# against the float64 oracle is transitively a bit-identity with the int64 oracle those
# rows already passed against. 2048x4096x4096 twice: the first wall may include a JIT
# compile, the second is cache-warm.
set -u
source "C:/Users/<user>/.claude/jobs/77babca4/tmp/ironenv.sh"
cd "$HOME/PycharmProjects/ryzen-ai-xdna1-quantization" || exit 1
snap() { powershell -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { \$_.Name -match '^(python|aiecc|clang|peano)' } | ForEach-Object { '{0} {1} {2}' -f \$_.ProcessId, \$_.Name, (\$_.CommandLine -replace '\s+',' ').Substring(0, [Math]::Min(140, (\$_.CommandLine).Length)) }"; }
echo "=== float64-reference proof on the NPU. start $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "--- other python/compiler processes at start ---"; snap
echo "--- xrt-smi aie-partitions before ---"; "C:/Windows/System32/AMD/xrt-smi.exe" examine -r aie-partitions 2>&1 | grep -i 'hardware context\|pid\|Phoenix' 
echo "--- live whole_array.py patch state ---"; (cd "$HOME/mlir-aie" && for p in kernels/gemm_tile_sweep/whole_array_c_single_buffer.patch kernels/int8_matmul_sweep/whole_array_int_reference_float64.patch; do git apply --check -R "$HOME/PycharmProjects/ryzen-ai-xdna1-quantization/$p" && echo "applied: $p"; done)
D="python kernels/int8_matmul_sweep/npu_matmul_sweep.py --iters 10 --warmup 3"
echo; echo "######## RUN 1: 512^3 and 2048x4096x4096, int8 -> int32, default tile ########"
$D --shapes 512x512x512,2048x4096x4096
echo; echo "######## RUN 2: 2048x4096x4096 again (JIT cache warm) ########"
$D --shapes 2048x4096x4096
echo; echo "--- xrt-smi aie-partitions after ---"; "C:/Windows/System32/AMD/xrt-smi.exe" examine -r aie-partitions 2>&1 | grep -i 'hardware context\|pid'
echo "--- other python/compiler processes at end ---"; snap
echo "=== done $(date '+%Y-%m-%d %H:%M:%S') ==="

