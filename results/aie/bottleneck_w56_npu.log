----------------------------------------------------------------------------------
    32x56    249.56    3.2117    2.5590    0.6526      97.5      77.7  yes
    56x56    436.73    4.9321    4.2435    0.6886     102.9      88.5  yes

FIT  hw_time_ms = intercept + slope * FLOPs
