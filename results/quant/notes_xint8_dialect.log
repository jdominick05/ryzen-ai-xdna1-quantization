192: class AdaroundConstants:
193:     """Constants used for Adarounding"""
194: 
195:     GAMMA = -0.1
196:     ZETA = 1.1
225:         alpha = self.alpha.to(device=tensor.device, dtype=tensor.dtype)
226:         h_alpha = self._get_h_alpha(alpha).to(tensor.dtype)
227:         self.round_func = lambda input: torch.floor(input) + h_alpha  # type: ignore
228: 
229:     def initialize_alpha(self, tensor: torch.Tensor) -> None:
230:         """
231:         Initializes alpha parameter, same shape as the tensor
232:         :param tensor: The tensor to be ada-rounded
233:         """
234:         if self.alpha is not None:
235:             return
236: 
237:         tensor_floor = torch.floor(tensor / self.scale)
238: 
239:         tensor_diff = (tensor / self.scale) - tensor_floor
240:         alpha = -torch.log(
241:             (AdaroundConstants.ZETA - AdaroundConstants.GAMMA) / (tensor_diff - AdaroundConstants.GAMMA) - 1
242:         )
243: 
244:         # Even if the input is integer type, alpha has to be kept in float32
245:         # in order to be updated by the optimizer
246:         self.alpha = torch.nn.Parameter(alpha.float(), requires_grad=True)
247: 
248:     def _get_h_alpha(self, alpha: torch.Tensor) -> torch.Tensor:
249:         """
250:         Calculate h_alpha tensor
251:         :return: the h_alpha tensor
252:         """
253:         # Soft rounding maps alpha parameter between zero and one using
254:         # rectified sigmoid function and hard rounding maps it to exactly zero or one
255:         if self.use_soft_rounding:
256:             h_alpha = torch.clamp(
257:                 torch.sigmoid(alpha) * (AdaroundConstants.ZETA - AdaroundConstants.GAMMA) + AdaroundConstants.GAMMA,
258:                 0,
259:                 1,
260:             )
261:         else:
262:             h_alpha = alpha >= 0
263:         return h_alpha
