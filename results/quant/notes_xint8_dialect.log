125:                 rec = kw * kh
126:                 n_max = 7 + math.ceil(math.log2(rec))
127:                 ns = range(0, n_max)
128:                 ns_pow = [2**n for n in ns]
129:                 ks = [round(ns_p / rec) for ns_p in ns_pow]
130:                 diffs = [abs(k / ns_p - 1 / rec) for k, ns_p in zip(ks, ns_pow, strict=False)]
131:                 n = diffs.index(min(diffs))
132:                 k = ks[n]
133:                 scale = k / 2**n
134:                 scale *= rec
135:                 return scale
