61:     @staticmethod
62:     def _calculate_beta(max_iter: int, cur_iter: int, beta_range: tuple[float, float], warm_start: float) -> Any:
63:         """
64:         Calculate beta parameter used in regularization function using cosine decay
65:         :param max_iter: Total maximum number of iterations
66:         :param cur_iter: Current iteration
67:         :param beta_range: Range for beta decay (start_beta, end_beta)
68:         :param warm_start: Warm up period, during which rounding loss has zero effect
69:         :return: Parameter beta
70:         """
71:         assert cur_iter < max_iter, "Current iteration should be less than total maximum number of iterations."
72: 
73:         start_beta, end_beta = beta_range
74: 
75:         warm_start_end_iter = warm_start * max_iter
76: 
77:         rel_iter = (cur_iter - warm_start_end_iter) / (max_iter - warm_start_end_iter)
78: 
79:         beta = end_beta + 0.5 * (start_beta - end_beta) * (1 + np.cos(rel_iter * np.pi))
