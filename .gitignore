modelcachekey/
yolocachekey/
yolocutcachekey/
yoloposecutcachekey/
yolocut1x4cachekey/
*.xclbin

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Local tooling configuration ----------------------------------------
# Editor and assistant settings are specific to one developer's workflow and
# are not part of the project.
.idea/
.vscode/
.claude/
CLAUDE.md
model.onnx
# Quark drops this in the cwd on every quantization run
quantized_info.csv
# Antigravity CLI
.agy/

# --- Run outputs ---------------------------------------------------------
# COCO detection dumps are 2-3 MB each and are regenerated by 5_eval_map.py.
# The *.log files in results/ are small and ARE tracked deliberately.
results/dets_*.json
