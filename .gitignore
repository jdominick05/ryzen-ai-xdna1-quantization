# --- Run outputs ---------------------------------------------------------
# COCO detection dumps are 2-3 MB each and are regenerated by 5_eval_map.py.
# The *.log files in results/ are small and ARE tracked deliberately.
results/dets_*.json
scratch/
# The TUI (tui/, scripts/tui.sh) writes every result it produces here, never into
# results/ -- that tree is the tracked evidence base and 69 of its images are cited
# from the docs. Sidecar JSONs here record a hostname, so this stays local.
outputs/

# --- Build artifacts -----------------------------------------------------
tools/build/
tools/dist/
*.spec
*.obj
*.exe
.stfolder/

