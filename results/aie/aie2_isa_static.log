        0x0190  (all nop)
        0x01a0  (all nop)
        0x01aa  (all nop)
        0x01ac  add	r2, r17, r2
        0x01b0  st	r2, [p0, #0] | add	r17, r17, #0x1
    loop .L_LEnd1 0x200-0x260: 8 bundles = 8 cycles/iteration, 8 live ops, density 1.00 of 6
        0x0200  event	#0x0
        0x0210  event	#0x1
