    loop .L_LEnd0: 1 of 32 bundles  <-- in the steady-state loop
      0x02b8  vlda	wl2, [p2], #0x200 | vldb	wh0, [p1, #0x20] | mov	p1, r11 | vmac.f	bml2, bml2, x8, x0, r3

