86:     def convert_sigmoid_to_hard_sigmoid(self) -> None:
87:         """Convert Sigmoid to HardSigmoid."""
88:         nodes_to_remove = []
89:         for node in self.model.graph.node:
90:             if node.op_type == "Sigmoid" and self.should_quantize_node(node):
91:                 hard_sigmoid_node = onnx.helper.make_node(
92:                     "HardSigmoid", inputs=node.input, outputs=node.output, name=node.name
93:                 )
94:                 hard_sigmoid_alpha = onnx.helper.make_attribute("alpha", 1.0 / 6.0)
95:                 hard_sigmoid_node.attribute.append(hard_sigmoid_alpha)
96:                 self.model.graph.node.append(hard_sigmoid_node)
97:                 nodes_to_remove.append(node)
98:                 logger.info(f"Found Sigmoid node {node.name}. Replacing with HardSigmoid.")
99:         self.model = remove_nodes(self.model, nodes_to_remove)
