190:     def split_large_kernel_pool(self) -> None:
191:         """
192:         For pooling with an excessively large kernel size in the onnx model,
193:         split it into multiple smaller poolings.
194:         """
195: 
196:         def _get_factors(num: int) -> tuple[int, int]:
197:             factor_1 = int(sqrt(num))
198:             while factor_1 > 1:
199:                 if num % (factor_1) == 0:
200:                     factor_2 = num / factor_1
201:                     return int(factor_1), int(factor_2)
202:                 factor_1 = factor_1 - 1
203:             factor_2 = num
204:             return int(factor_1), int(factor_2)
205: 
206:         onnx_model = ONNXModel(self.model)
207:         for node in onnx_model.model.graph.node:
208:             if node.op_type == "GlobalAveragePool" and self.should_quantize_node(node):
209:                 input_name = node.input[0]
210:                 kw = None
211:                 kh = None
212:                 for input_info in onnx_model.model.graph.value_info:
213:                     if input_info.name == input_name:
214:                         input_shape = [dim.dim_value for dim in input_info.type.tensor_type.shape.dim]
215:                         if len(input_shape) == 4:
216:                             kh = input_shape[2]
217:                             kw = input_shape[3]
218:                         break
219:                 if not kw or not kh:
220:                     logger.warning(f"Failed to get the input shape, skip optimizing for GlobalAveragePool {node.name}.")
221:                     continue
222:                 # Only one split is supported.
223:                 # TODO: Support multiple split operations
224:                 elif kw * kh > 512:
225:                     kh1, kh2 = _get_factors(kh)
226:                     kw1, kw2 = _get_factors(kw)
227:                     if kh1 * kw1 > 512 or kh2 * kw2 > 512:
228:                         logger.warning(
229:                             "After split, the kernel size is still too large."
230:                             "Currently, only one split is supported. Skip optimization."
231:                         )
232:                     else:
233:                         split_tensor = node.input[0] + "_Split"
234:                         pool_node = onnx.helper.make_node(
235:                             "AveragePool",
236:                             inputs=[node.input[0]],
237:                             outputs=[split_tensor],
238:                             kernel_shape=[kh1, kw1],
239:                             strides=[kh1, kw1],
240:                             name=split_tensor,
241:                         )
242:                         if not node.name:
243:                             node.name = node.output[0]
244:                         node.input[0] = split_tensor
245:                         onnx_model.model.graph.node.extend([pool_node])
246:                         logger.info(
247:                             f"Found GlobalAveragePool node {node.name} with large kernel size. "
248:                             f"Split it into multiple AveragePools."
249:                         )
250:         onnx_model.clean_initializers()
