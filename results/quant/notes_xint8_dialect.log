504:                             tensor_name, quantized_value.scale_name, quantized_value.zp_name
505:                         )
506:                     else:
507:                         # Conversion case: <producer> ---> Q_shared -+-> DQ_shared --> <consumers of original type>
508:                         #                                            |
509:                         #                                            +-> DQ_shared' --> Q2 --> DQ2 --> <consumers of converted type>
